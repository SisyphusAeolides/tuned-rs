#!/sbin/openrc-run

supervisor=supervise-daemon
name="tuned-rs-ppd"
description="Power Profiles compatibility daemon for tuned-rs"
command=/usr/bin/tuned-rs-ppd
command_args=""
respawn_delay=2
respawn_max=5
respawn_period=1800

depend() {
	need dbus tuned-rs
	after tuned-rs
	provide power-profiles-daemon
}
